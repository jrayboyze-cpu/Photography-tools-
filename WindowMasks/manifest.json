{
  "id": "com.antigravity.windowmasks",
  "name": "Window Masks - Architectural",
  "version": "1.0.0",
  "main": "index.html",
  "manifestVersion": 4,
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0",
      "data": {
        "apiVersion": 2
      }
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "windowMasksPanel",
      "label": {
        "default": "Window Masks"
      },
      "minimumSize": {
        "width": 260,
        "height": 400
      },
      "maximumSize": {
        "width": 420,
        "height": 1000
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 600
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 640
      }
    }
  ]
}
